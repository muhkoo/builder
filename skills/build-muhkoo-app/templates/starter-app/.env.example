# Copy to .env.local and fill in. The scaffold step writes these for you.

# The publishable app key (mk_test_pk_… for dev, mk_live_pk_… for prod).
# Safe to ship in a browser bundle.
VITE_MUHKOO_KEY=mk_test_pk_xxxxxxxxxxxxxxxx

# The Muhkoo API base URL.
#   production: https://api.muhkoo.dev
#   staging:    https://api.staging.muhkoo.dev
VITE_WORKER_URL=https://api.muhkoo.dev

# Your app's id — authorizes hosted sign-in (auth.muhkoo.dev). The scaffold
# writes this; register your callback URL in the portal (App Detail → Hosted
# sign-in). Your callback URL = your app's origin (this single-page template
# returns to its root).
VITE_MUHKOO_APP_ID=

# Optional: override the hosted auth page (only for staging/dev). When unset the
# SDK default (auth.muhkoo.dev) applies.
#   staging: https://auth.staging.muhkoo.dev
# VITE_AUTH_URL=
