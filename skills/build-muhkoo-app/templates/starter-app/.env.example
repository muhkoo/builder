# Copy to .env.local and fill in. The scaffold step writes these for you.

# The publishable app key (mk_test_pk_… for dev, mk_live_pk_… for prod).
# Safe to ship in a browser bundle.
VITE_MUHKOO_KEY=mk_test_pk_xxxxxxxxxxxxxxxx

# The Muhkoo API base URL.
#   production: https://api.muhkoo.dev
#   staging:    https://api.staging.muhkoo.dev
VITE_WORKER_URL=https://api.muhkoo.dev
